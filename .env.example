# MongoDB (existing backend)
MONGODB_URI=mongodb://<YOUR_MONGO_USER>:<YOUR_MONGO_PASSWORD>@mongo:27017/chatApp?authSource=admin&retryWrites=true&w=majority
JWT_SECRET=<your_strong_random_secret>
PORT=5001
NODE_ENV=production

# PostgreSQL (notification service) - copy this file to .env and fill in real values
# NEVER commit .env with real credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_strong_postgres_password>
POSTGRES_DB=notifications
